##############################
# Shared
##############################
PUBLISHER_API_KEY=change-me

##############################
# apps/web
##############################
# Proxy target for Next.js API route
PUBLISHER_URL=http://localhost:4000/publish

##############################
# services/publisher
##############################
PORT=4000
API_KEY=change-me
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
MAX_UPLOAD_BYTES=104857600
MAX_FILE_COUNT=200
DEFAULT_EXPIRATION=30d

# Directory that contains .shelby/config.yaml
SHELBY_CONFIG_DIR=/path/to/shelby

# Shelby REST base (no trailing slash)
SHELBY_REST_BASE=https://api.shelby.example

# Optional AI enrichment
AI_ENABLED=false
